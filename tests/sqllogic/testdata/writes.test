# INSERT, UPDATE and DELETE with defaults, conversions and constraints.

statement ok
CREATE TABLE t (id integer PRIMARY KEY, name text NOT NULL DEFAULT 'none', score double precision, code text UNIQUE, at timestamptz DEFAULT now())

statement ok INSERT 0 3
INSERT INTO t (id, name, score, code) VALUES (1, 'ann', 9.5, 'A'), (2, 'bob', NULL, 'B'), (3, 'cy', 7, NULL)

statement ok INSERT 0 1
INSERT INTO t (id) VALUES (4)

statement ok INSERT 0 1
INSERT INTO t VALUES (5, 'eve')

statement ok INSERT 0 1
INSERT INTO t VALUES (6, DEFAULT, '8.25', 'F', '2024-01-01 12:00:00+00')

query ITRTD
SELECT * FROM t ORDER BY id
----
1|ann|9.5|A|2024-05-06 07:08:09.5+00
2|bob|NULL|B|2024-05-06 07:08:09.5+00
3|cy|7|NULL|2024-05-06 07:08:09.5+00
4|none|NULL|NULL|2024-05-06 07:08:09.5+00
5|eve|NULL|NULL|2024-05-06 07:08:09.5+00
6|none|8.25|F|2024-01-01 12:00:00+00

# Assignment conversions: numbers between numeric types, anything to text.
statement ok
INSERT INTO t (id, name, score) VALUES (7.4, 42, 3)

query IT
SELECT id, name FROM t WHERE id = 7
----
7|42

statement error 42804 column "id" is of type integer but expression is of type boolean
INSERT INTO t (id) VALUES (true)

statement error 42804 column "at" is of type timestamp with time zone but expression is of type integer
INSERT INTO t (id, at) VALUES (8, 5)

statement error 22003 integer out of range
INSERT INTO t (id) VALUES (3000000000)

statement error 42601 INSERT has more expressions than target columns
INSERT INTO t (id) VALUES (8, 'x')

statement error 42601 INSERT has more target columns than expressions
INSERT INTO t (id, name) VALUES (8)

statement error 42601 VALUES lists must all be the same length
INSERT INTO t (id, name) VALUES (8, 'a'), (9)

statement error 42703 column "nope" of relation "t" does not exist
INSERT INTO t (nope) VALUES (1)

statement error 42701 column "id" specified more than once
INSERT INTO t (id, id) VALUES (1, 2)

# Constraints, with PostgreSQL's messages and details.
statement error 23505 duplicate key value violates unique constraint "t_pkey"
INSERT INTO t (id) VALUES (1)

statement error 23505 duplicate key value violates unique constraint "t_code_key"
INSERT INTO t (id, code) VALUES (10, 'A')

statement error 23505
INSERT INTO t (id, code) VALUES (10, 'Z'), (11, 'Z')

statement error 23502 null value in column "name" of relation "t" violates not-null constraint
INSERT INTO t (id, name) VALUES (10, NULL)

statement error 23502 null value in column "id" of relation "t" violates not-null constraint
INSERT INTO t (name) VALUES ('x')

# A failed multi-row INSERT inserts nothing.
statement error 23505
INSERT INTO t (id) VALUES (20), (21), (1)

query I
SELECT id FROM t WHERE id >= 20
----

# UPDATE: all assignments see the old row; DEFAULT; uniqueness at the end.
statement ok UPDATE 2
UPDATE t SET score = score * 2, name = name || '!' WHERE score > 8

query ITR
SELECT id, name, score FROM t WHERE name LIKE '%!' ORDER BY id
----
1|ann!|19
6|none!|16.5

statement ok UPDATE 1
UPDATE t SET name = DEFAULT, at = DEFAULT WHERE id = 6

query TD
SELECT name, at FROM t WHERE id = 6
----
none|2024-05-06 07:08:09.5+00

statement ok UPDATE 7
UPDATE t SET id = id + 1

statement ok UPDATE 7
UPDATE t SET id = id - 1

query I
SELECT id FROM t ORDER BY id
----
1
2
3
4
5
6
7

statement ok UPDATE 2
UPDATE t SET code = CASE code WHEN 'A' THEN 'B' ELSE 'A' END WHERE code IN ('A', 'B')

query IT
SELECT id, code FROM t WHERE code IS NOT NULL ORDER BY code
----
2|A
1|B
6|F

statement error 23505 duplicate key value violates unique constraint "t_pkey"
UPDATE t SET id = 1 WHERE id IN (2, 3)

statement error 23502
UPDATE t SET name = NULL

statement error 22012 division by zero
UPDATE t SET score = 1 / (id - 4)

statement error 42601 multiple assignments to same column "name"
UPDATE t SET name = 'a', name = 'b'

statement error 42703 column "nope" of relation "t" does not exist
UPDATE t SET nope = 1

statement ok UPDATE 0
UPDATE t SET name = 'x' WHERE false

statement ok UPDATE 1
UPDATE t AS u SET name = u.name || '?' WHERE u.id = 3

# DELETE.
statement ok DELETE 2
DELETE FROM t WHERE score IS NULL AND id > 3

query IT
SELECT id, name FROM t ORDER BY id
----
1|ann!
2|bob
3|cy?
6|none
7|42

statement ok DELETE 0
DELETE FROM t WHERE id > 100

# Deleted keys can be used again.
statement ok
INSERT INTO t (id, code) VALUES (4, 'D'), (5, 'E')

restart

statement ok DELETE 7
DELETE FROM t

query I
SELECT id FROM t
----

crash

query I
SELECT id FROM t
----

statement ok
INSERT INTO t (id, code) VALUES (1, 'A')
