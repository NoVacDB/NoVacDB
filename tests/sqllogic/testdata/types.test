# Types, literals, casts and their text forms (PostgreSQL 16, DateStyle ISO,
# TimeZone UTC).

query IIRTBD
SELECT 1, 9223372036854775807, 1.5, 'text', true, '2024-01-02 03:04:05.678+00'::timestamptz
----
1|9223372036854775807|1.5|text|t|2024-01-02 03:04:05.678+00

# Integer literal types: integer if it fits, else bigint.
query II
SELECT 2147483647 + 0, 2147483648 + 0
----
2147483647|2147483648

statement error 22003 integer out of range
SELECT 2147483647 + 1

statement error 22003 bigint out of range
SELECT 9223372036854775807 + 1

# Double precision output: shortest round-trip form.
query RRRRRRR
SELECT 0.1, 1e15, 1e14, 1.0e-5, 0.0001, -0.0, 1/3.0
----
0.1|1e+15|100000000000000|1e-05|0.0001|-0|0.3333333333333333

query RRR
SELECT 'NaN'::double precision, 'infinity'::double precision, '-Infinity'::double precision
----
NaN|Infinity|-Infinity

statement error 22003
SELECT 1e308 * 10

statement error 22P02 invalid input syntax for type double precision
SELECT 'one'::double precision

# Integer input forms.
query III
SELECT ' 42 '::integer, '0x1F'::integer, '1_000_000'::bigint
----
42|31|1000000

statement error 22P02 invalid input syntax for type integer: "4.5"
SELECT '4.5'::integer

statement error 22003 value "3000000000" is out of range for type integer
SELECT '3000000000'::integer

# Float to integer rounds half to even.
query IIII
SELECT 0.5::integer, 1.5::integer, 2.5::integer, (-2.5)::integer
----
0|2|2|-2

# Booleans.
query BBBBBB
SELECT 't'::boolean, 'yes'::boolean, 'on'::boolean, 'FALSE'::boolean, '0'::boolean, 1::boolean
----
t|t|t|f|f|t

statement error 22P02 invalid input syntax for type boolean
SELECT 'maybe'::boolean

query I
SELECT true::integer + false::integer
----
1

# Timestamps: zones, fractions, special values.
query DDDD
SELECT '2024-02-29T12:00:00Z'::timestamptz, '2024-03-01 01:00:00+05:30'::timestamptz, '2000-01-01'::timestamptz, 'epoch'::timestamptz
----
2024-02-29 12:00:00+00|2024-02-29 19:30:00+00|2000-01-01 00:00:00+00|1970-01-01 00:00:00+00

query DD
SELECT 'infinity'::timestamptz, '-infinity'::timestamptz
----
infinity|-infinity

query D
SELECT '2024-01-01 00:00:00.0000005+00'::timestamptz
----
2024-01-01 00:00:00+00

query D
SELECT '2024-01-01 00:00:00.0000015+00'::timestamptz
----
2024-01-01 00:00:00.000002+00

statement error 22008
SELECT '2023-02-29'::timestamptz

statement error 22007
SELECT 'yesterday at noon'::timestamptz

# Casts to text and between types.
query TTTTT
SELECT 42::text, 1.5::text, true::text, '2024-01-01'::timestamptz::text, NULL::text
----
42|1.5|true|2024-01-01 00:00:00+00|NULL

statement error 42846 cannot cast type boolean to timestamp with time zone
SELECT true::timestamptz

statement error 42846 cannot cast type double precision to boolean
SELECT 1.5::boolean

# Untyped literals take the other operand's type.
query BBB
SELECT '10' > 9, '2024-01-01' < now(), 'abc' = 'abc'
----
t|t|t

statement error 22P02 invalid input syntax for type integer: "ten"
SELECT 'ten' > 9

# Text: bytes order (C collation), empty string.
query BBT
SELECT 'B' < 'a', '' < 'a', ''
----
t|t|(empty)
